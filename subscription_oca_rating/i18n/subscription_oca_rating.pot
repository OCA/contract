#. module: subscription_oca_rating
#: model:mail.template,body_html:subscription_oca_rating.mail_template_subscription_rating_request
msgid ""
"<t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"            <t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"            <div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Hello\n"
"                    <t t-out=\"partner.name or ''\"/>,\n"
"                </p>\n"
"                <p>\n"
"                    We would like to know how you feel about your subscription\n"
"                    (<t t-out=\"object.name or ''\"/>).\n"
"                    Please rate your experience by clicking one of the smileys below.\n"
"                </p>\n"
"                <table summary=\"Rating\" style=\"margin: 16px 0;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 0 8px;\">\n"
"                            <a t-attf-href=\"/rate/{{ access_token }}/5\" title=\"Satisfied\">😊</a>\n"
"                        </td>\n"
"                        <td style=\"padding: 0 8px;\">\n"
"                            <a t-attf-href=\"/rate/{{ access_token }}/3\" title=\"Okay\">😐</a>\n"
"                        </td>\n"
"                        <td style=\"padding: 0 8px;\">\n"
"                            <a t-attf-href=\"/rate/{{ access_token }}/1\" title=\"Dissatisfied\">😞</a>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

