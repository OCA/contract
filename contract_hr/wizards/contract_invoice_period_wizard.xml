<odoo>
    <record id="view_contract_invoice_period_wizard_form" model="ir.ui.view">
        <field name="name">contract.invoice.period.wizard.form</field>
        <field name="model">contract.invoice.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Selecionar Período para Faturamento">
                <group>
                    <field name="contract_id" readonly="1" />
                    <field name="date_start" required="1" />
                    <field name="date_end" required="1" />
                </group>
                <footer>
                    <button
                        string="Confirmar"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
