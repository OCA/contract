<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <!-- Extend employee form view to show freelancer/contractor contracts -->

        <!-- Add action for employee contracts -->
        <record id="action_hr_employee_contracts" model="ir.actions.act_window">
            <field name="name">Freelancer/Contractor</field>
            <field name="res_model">contract.contract</field>
            <field name="view_mode">tree,form</field>
            <field
            name="domain"
        >[('employee_id', '=', active_id), ('employee_type', 'in', ['freelance', 'contractor'])]</field>
            <field name="context">{}</field>
        </record>

        <record
        id="action_supplier_contract_view_tree"
        model="ir.actions.act_window.view"
    >
            <field name="sequence" eval="1" />
            <field name="view_mode">tree</field>
            <field name="view_id" ref="contract.contract_contract_tree_view" />
            <field name="act_window_id" ref="action_hr_employee_contracts" />
        </record>
        <record
        id="action_supplier_contract_view_form"
        model="ir.actions.act_window.view"
    >
            <field name="sequence" eval="2" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="contract.contract_contract_supplier_form_view" />
            <field name="act_window_id" ref="action_hr_employee_contracts" />
        </record>

        <record id="hr_employee_form_view_inherit" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.contract_hr</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                    name="%(contract_hr.action_hr_employee_contracts)d"
                    type="action"
                    icon="fa-book"
                    class="oe_stat_button"
                    attrs="{'invisible': [('employee_type', 'not in', ['freelance', 'contractor'])]}"
                    context="{'search_default_employee_id': active_id, 'default_employee_id': active_id}"
                >
                            <div class="o_stat_info">
                                <span class="o_stat_value text-success">
                                    <field name="contract_contract_count" />
                                </span>
                                <span class="o_stat_text">
                                    Contractor/Freelancer
                                </span>
                            </div>
                    </button>
                </xpath>
            </field>
        </record>

        <menuitem
        id="contract_hr_menu_contract_history"
        action="action_hr_employee_contracts"
        parent="hr.menu_hr_employee_payroll"
        name="Contractor/Freelancer"
        sequence="14"
        groups="hr_contract.group_hr_contract_manager"
    />

</odoo>
