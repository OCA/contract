<odoo>
    <record id="contract_terminate_reason_form_view" model="ir.ui.view">
        <field name="model">contract.terminate.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="terminate_comment_required" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="contract_terminate_reason_tree_view" model="ir.ui.view">
        <field name="model">contract.terminate.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="terminate_comment_required" />
            </list>
        </field>
    </record>
    <record id="contract_terminate_reason_act_window" model="ir.actions.act_window">
        <field name="name">Contract Termination Reason</field>
        <field name="res_model">contract.terminate.reason</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="contract_terminate_reason_menu" model="ir.ui.menu">
        <field name="name">Contract Termination Reason</field>
        <field name="parent_id" ref="contract.menu_config_contract" />
        <field name="action" ref="contract_terminate_reason_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
