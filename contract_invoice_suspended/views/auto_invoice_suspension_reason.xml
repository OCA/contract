<odoo>
  <record model="ir.ui.view" id="auto_invoice_suspension_reason_form_view">
    <field name="model">contract.automatic.invoice.suspension.reason</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="parent_id" />
            <field name="can_be_selected" />
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="auto_invoice_suspension_reason_tree_view">
    <field name="model">contract.automatic.invoice.suspension.reason</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle" />
        <field name="name" />
        <field name="parent_id" />
        <field name="can_be_selected" />
        <field name="company_id" groups="base.group_multi_company" />
      </list>
    </field>
  </record>

  <record model="ir.actions.act_window" id="auto_invoice_suspension_reason_act_window">
    <field name="name">Contract Automatic Invoice Suspension Reason</field>
    <field name="res_model">contract.automatic.invoice.suspension.reason</field>
    <field name="view_mode">list,form</field>
  </record>

  <record model="ir.ui.menu" id="slc_auto_invoice_suspension_reason_menu">
    <field name="name">Automatic Invoice Suspension Reason</field>
    <field name="parent_id" ref="sale.menu_sale_config" />
    <field name="action" ref="auto_invoice_suspension_reason_act_window" />
  </record>
</odoo>
