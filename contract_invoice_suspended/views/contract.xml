<odoo>
  <record id="contract_contract_form_view" model="ir.ui.view">
    <field name="model">contract.contract</field>
    <field name="inherit_id" ref="contract.contract_contract_form_view" />
    <field name="arch" type="xml">
      <field name="contract_type" position="after">
        <field name="is_auto_invoice_suspended" />
        <field
          name="auto_invoice_suspended_user_id"
          invisible="is_auto_invoice_suspended != True"
        />
        <field
          name="auto_invoice_suspended_date"
          invisible="is_auto_invoice_suspended != True"
        />
        <field
          name="auto_invoice_suspended_reason_id"
          invisible="is_auto_invoice_suspended != True"
        />
      </field>
    </field>
  </record>
</odoo>
