<templates xml:space="preserve">
    <t
        t-name="subscription_oca.SectionAndNoteRecordRow"
        t-inherit="account.SectionAndNoteListRenderer.RecordRow"
        t-inherit-mode="extension"
    >
        <xpath expr="//DropdownItem[i[hasclass('fa-sticky-note-o')]]" position="after">
            <DropdownItem
                t-if="record.data.invoice_once !== undefined"
                onSelected="() => this.toggleInvoiceOnce(record)"
            >
                <i
                    class="me-1 fa fa-fw"
                    t-att-class="record.data.invoice_once ? 'fa-check-square-o' : 'fa-square-o'"
                />
                <span>Invoice once</span>
            </DropdownItem>
        </xpath>
    </t>
</templates>
