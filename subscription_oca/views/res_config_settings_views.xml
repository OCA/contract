<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.subscription.oca</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Subscriptions" name="subscription_oca_setting_container">
                    <setting
                        id="subscription_period_date_format_setting"
                        string="Period date format"
                        help="Date format used for the billed period shown on invoice lines. Leave empty to use the customer language format."
                    >
                        <field
                            name="subscription_period_date_format"
                            placeholder="e.g. dd/MM/yyyy"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
