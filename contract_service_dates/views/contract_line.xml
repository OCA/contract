<odoo>
    <record id="contract_line_form_view" model="ir.ui.view">
        <field name="name">contract.line form view (in contract_service_dates)</field>
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract_dates']" position="after">
                <group string="Service Dates" name="service_dates">
                    <group>
                        <field name="service_start_date" />
                    </group>
                    <group>
                        <field name="service_end_date" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
