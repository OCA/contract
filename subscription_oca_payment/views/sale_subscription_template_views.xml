<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_subscription_template_form" model="ir.ui.view">
        <field name="name">sale.subscription.template.form - payments</field>
        <field name="model">sale.subscription.template</field>
        <field
            name="inherit_id"
            ref="subscription_oca.sale_subscription_template_form"
        />
        <field name="arch" type="xml">
            <field name="invoicing_mode" position="after">
                <field name="auto_create_payment" />
                <field
                    name="payment_failure_mail_template_id"
                    invisible="not auto_create_payment"
                />
                <field name="auto_retry_payment" invisible="not auto_create_payment" />
                <field
                    name="auto_retry_payment_count"
                    invisible="not auto_create_payment or not auto_retry_payment"
                />
                <field
                    name="auto_retry_payment_hours"
                    invisible="not auto_create_payment or not auto_retry_payment"
                />
            </field>
        </field>
    </record>
</odoo>
