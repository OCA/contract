<odoo>
    <record id="termination_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form (in product_contract_termination)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list//field[@name='contract_id']"
                position="attributes"
            >
                <attribute name="domain">['|', ('contract_template_id','=',contract_template_id), ('contract_template_id','=',False), ('partner_id','=',parent.partner_id), ('is_terminated','=',False), ]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='contract_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >['|', ('contract_template_id','=',contract_template_id), ('contract_template_id','=',False), ('partner_id','=',parent.partner_id), ('is_terminated','=',False), ]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='tax_id']/parent::group/following-sibling::group/field[@name='is_auto_renew']"
                position="after"
            >
                <field name="automatic_price" />
            </xpath>
            <xpath expr="//field[@name='is_auto_renew'][1]" position="after">
                <field name="automatic_price" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='auto_renew_interval']" position="after">
                <field name="manual_renew_needed" class="oe_inline" optional="hide" />
                <field name="termination_notice_interval" class="oe_inline" optional="hide"/>
                <field name="termination_notice_rule_type" class="oe_inline" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
