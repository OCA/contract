<odoo>
    <!-- TODO This could be moved to a bridge module with contract_line_defer and contract_line_successor -->
    <record model="ir.ui.view" id="contract_contract_form_view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='contract_line_ids']//list"
                position="attributes"
            >
                <attribute name="decoration-muted">is_deferred</attribute>
                <attribute
                    name="decoration-info"
                    add="not is_deferred"
                    separator="and"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="contract_line_tree_view">
        <field name="model">contract.line</field>
        <field
            name="inherit_id"
            ref="contract_line_successor.contract_line_tree_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-muted">is_deferred</attribute>
                <attribute
                    name="decoration-info"
                    add="not is_deferred"
                    separator="and"
                />
            </xpath>
        </field>
    </record>
</odoo>
