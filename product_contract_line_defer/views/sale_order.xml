<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//field[@name='date_start']"
                position="before"
            >
                <field name="is_deferred" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='date_start']"
                position="attributes"
            >
                <attribute name="invisible">is_deferred</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list//field[@name='date_start']"
                position="before"
            >
                <field name="is_deferred" optional="hide" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list//field[@name='date_start']"
                position="attributes"
            >
                <attribute name="invisible">is_deferred</attribute>
            </xpath>
        </field>
    </record>
</odoo>
