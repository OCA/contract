<odoo>
    <record model="ir.ui.view" id="product_contract_configurator_form_view">
        <field name="model">product.contract.configurator</field>
        <field
            name="inherit_id"
            ref="product_contract.product_contract_configurator_form"
        />
        <field name="arch" type="xml">
            <field name="date_start" position="before">
                <field name="is_deferred" />
            </field>
            <field name="date_start" position="attributes">
                <attribute name="invisible">is_deferred</attribute>
            </field>
        </field>
    </record>
</odoo>
