<odoo>
    <record model="ir.ui.view" id="contract_manually_create_invoice_form_view">
        <field name="model">contract.manually.create.invoice</field>
        <field
            name="inherit_id"
            ref="contract.contract_manually_create_invoice_form_view"
        />
        <field name="arch" type="xml">
            <button name="create_invoice" position="after">
                <button
                    name="create_invoice_batch"
                    invisible="contract_to_invoice_count == 0"
                    string="Batch Create Invoices"
                    class="btn-secondary"
                    type="object"
                />
            </button>
        </field>
    </record>
</odoo>
