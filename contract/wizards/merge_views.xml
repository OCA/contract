<odoo>
    <record id="contract_merge_view_form" model="ir.ui.view">
        <field name="name">Form view for Merge contracts</field>
        <field name="model">contract.merge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p>Confirm?</p>
                </sheet>
                <footer>
                    <button
                        name="run"
                        type="object"
                        string="Run"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="contract_merge_action" model="ir.actions.act_window">
        <field name="name">Merge</field>
        <field name="res_model">contract.merge</field>
        <field name="binding_model_id" ref="contract.model_contract_contract" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
