<odoo>
    <record model="ir.ui.view" id="contract_template_line_form_view">
        <field name="model">contract.template.line</field>
        <field name="inherit_id" ref="contract.contract_template_line_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='recurrence_info']" position="after">
                <page
                    string="Minimum Term"
                    name="minimum_term"
                    invisible="display_type"
                >
                    <group name="minimum_term">
                        <group>
                            <label for="min_term_interval" />
                            <div class="o_row">
                                <field name="min_term_interval" class="oe_inline" />
                                <field name="min_term_rule_type" class="oe_inline" />
                            </div>
                            <label for="min_term_renewal_interval" />
                            <div class="o_row">
                                <field
                                    name="min_term_renewal_interval"
                                    class="oe_inline"
                                />
                                <field
                                    name="min_term_renewal_rule_type"
                                    class="oe_inline"
                                />
                            </div>
                            <label for="min_term_notice_interval" />
                            <div class="o_row">
                                <field
                                    name="min_term_notice_interval"
                                    class="oe_inline"
                                />
                                <field
                                    name="min_term_notice_rule_type"
                                    class="oe_inline"
                                />
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
