<odoo>
    <record model="ir.ui.view" id="contract_template_form_view">
        <field name="model">contract.template</field>
        <field name="inherit_id" ref="contract.contract_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='info']" position="before">
                <page string="Minimum Term" name="minimum_term">
                    <group name="minimum_term">
                        <group>
                            <label for="min_term_interval" />
                            <div class="o_row">
                                <field name="min_term_interval" class="oe_inline" />
                                <field
                                    name="min_term_rule_type"
                                    class="oe_inline"
                                    required="min_term_interval"
                                />
                            </div>
                        </group>
                    </group>
                    <p class="text-muted">
                        The renewal of the minimum term and the termination
                        notice are set on the contract lines (Renewal).
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
