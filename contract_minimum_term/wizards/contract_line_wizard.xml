<odoo>
    <record model="ir.ui.view" id="contract_line_wizard_stop_form_view">
        <field name="model">contract.line.wizard</field>
        <field
            name="inherit_id"
            ref="contract_line_successor.contract_line_wizard_stop_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="not is_stopped_before_min_term"
                >
                    The stop date is before the end of the minimum term or the
                    termination notice. Only users allowed to terminate
                    contracts before the minimum term can confirm it.
                </div>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="before">
                <field name="min_term_request_date" required="True" />
                <field
                    name="min_term_earliest_date"
                    invisible="not min_term_earliest_date"
                />
                <field name="is_stopped_before_min_term" invisible="1" />
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="contract_line_wizard_plan_successor_form_view">
        <field name="model">contract.line.wizard</field>
        <field
            name="inherit_id"
            ref="contract_line_successor.contract_line_wizard_plan_successor_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="not is_stopped_before_min_term"
                >
                    The end date is before the end of the minimum term of the
                    successor. Only users allowed to terminate contracts before
                    the minimum term can confirm it.
                </div>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="before">
                <field
                    name="min_term_earliest_date"
                    string="Earliest End Date"
                    invisible="not min_term_earliest_date"
                />
                <field name="is_stopped_before_min_term" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
