<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="product_contract.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//label[@for='recurrence_number']"
                position="before"
            >
                <field name="contract_duration_type" widget="radio" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//label[@for='recurrence_number']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >contract_duration_type == 'minimum_term'</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='recurrence_number']/.."
                position="attributes"
            >
                <attribute
                    name="invisible"
                >contract_duration_type == 'minimum_term'</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='date_end']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >contract_duration_type == 'minimum_term'</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='is_auto_renew']/.."
                position="before"
            >
                <group
                    name="minimum_term"
                    invisible="not is_contract or contract_duration_type != 'minimum_term'"
                >
                    <label for="min_term_interval" />
                    <div class="o_row">
                        <field name="min_term_interval" class="oe_inline" nolabel="1" />
                        <field
                            name="min_term_rule_type"
                            class="oe_inline"
                            nolabel="1"
                            required="min_term_interval"
                        />
                    </div>
                </group>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list//field[@name='date_end']"
                position="after"
            >
                <field name="contract_duration_type" optional="hide" />
                <field name="min_term_interval" optional="hide" />
                <field name="min_term_rule_type" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
