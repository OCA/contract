<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="contract.res_config_settings_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contract']" position="inside">
                <setting
                    class="col-12 col-lg-6 o_setting_box"
                    company_dependent="1"
                    help="At creation, defer contract lines by default (i.e. do not invoice until activated). Use this setting if you sell contracts which start dates are unknown at the conclusion of the sale."
                >
                    <field name="defer_contract_line_start" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
