<odoo>
    <record id="contract_template_line_view_form" model="ir.ui.view">
        <field name="name">contract.template.line.hide.detail.form</field>
        <field name="model">contract.template.line</field>
        <field name="inherit_id" ref="contract.contract_template_line_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name'][@nolabel='1']" position="after">
                <group invisible="display_type != 'line_section'">
                    <field name="show_details" />
                    <field name="show_section_subtotal" invisible="show_details" />
                    <field name="show_subtotal" invisible="not show_details" />
                    <field name="show_line_amount" invisible="not show_details" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
